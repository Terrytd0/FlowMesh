# Copy to `.env` and edit. Every variable is namespaced `FLOWMESH_`; nothing
# outside backend/config/ reads the environment directly.

# --- Application ---
FLOWMESH_APP_ENV=development
FLOWMESH_LOG_LEVEL=INFO
FLOWMESH_API_HOST=0.0.0.0
FLOWMESH_API_PORT=8000

# --- Auth ---
# Change this before exposing the API anywhere. Startup refuses to boot in
# production with auth disabled or with this default secret.
FLOWMESH_JWT_SECRET=dev-only-insecure-secret-change-me
FLOWMESH_ACCESS_TOKEN_EXPIRE_MINUTES=60
FLOWMESH_AUTH_ENABLED=true

# --- Database (system of record) ---
# Compose service name by default so `docker compose up` needs no override.
# Swap `+asyncpg` for `+aiosqlite` to run the whole pipeline on one process
# with no server -- same models, same SQL (docs/architecture.md section 4).
FLOWMESH_DATABASE_URL=postgresql+asyncpg://flowmesh:flowmesh@postgres:5432/flowmesh
# Aiosqlite form used by the local, test and load-test runs.
FLOWMESH_DATABASE_URL_SQLITE=sqlite+aiosqlite:///./data/runtime/flowmesh.sqlite3
FLOWMESH_DB_ECHO=false

# --- Kafka (event log) ---
FLOWMESH_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
FLOWMESH_KAFKA_ORDER_TOPIC=order-events
FLOWMESH_KAFKA_INVENTORY_TOPIC=inventory-events
FLOWMESH_KAFKA_PARTITIONS=6
FLOWMESH_EVENT_TRANSPORT=kafka

# --- RabbitMQ (task queue) ---
FLOWMESH_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
FLOWMESH_QUEUE_TRANSPORT=rabbitmq

# --- gRPC fraud scoring ---
FLOWMESH_GRPC_SERVER_HOST=0.0.0.0
FLOWMESH_GRPC_SERVER_PORT=50052
FLOWMESH_GRPC_CLIENT_TARGET=fraud:50052
FLOWMESH_GRPC_TIMEOUT_SECONDS=2.0
# How the order processor reaches the scorer:
#   "grpc"       always dial the service; fail if it is not there
#   "in_process" call the scoring engine directly, no wire at all
#   "auto"       dial it, and fall back to in-process if the health probe says
#                nothing is listening (the default, so one `uvicorn` is a
#                working dev setup)
FLOWMESH_FRAUD_TRANSPORT=auto

# --- Fraud model ---
FLOWMESH_FRAUD_MODEL_PATH=data/model/fraud_weights.json
# Risk bands. Below low is auto-approved, above high is held for review, and
# everything between is the ambiguous band that costs an LLM call.
FLOWMESH_FRAUD_LOW_THRESHOLD=0.35
FLOWMESH_FRAUD_HIGH_THRESHOLD=0.65

# --- LLM reasoner (ambiguous band only) ---
# Off by default: the deterministic reasoner explains the score with no network
# and no key, which is what keeps the p95 budget. Turn this on to compare.
FLOWMESH_LLM_ENABLED=false
FLOWMESH_LLM_MODEL=gpt-4o-mini
FLOWMESH_LLM_API_KEY=
FLOWMESH_LLM_BASE_URL=
FLOWMESH_LLM_TIMEOUT_SECONDS=3.0
FLOWMESH_LLM_MAX_TOKENS=200

# --- Inventory ---
FLOWMESH_INVENTORY_RESERVATION_TTL_SECONDS=900
FLOWMESH_REVIEW_SLA_SECONDS=3600

# --- Rate limiting / idempotency (Redis) ---
FLOWMESH_REDIS_URL=redis://redis:6379/0
FLOWMESH_RATE_LIMIT_PER_MINUTE=600

# --- Observability ---
FLOWMESH_METRICS_ENABLED=true
FLOWMESH_LOG_LEVEL_JSON=false
